<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.eunsoo.rss-music.scrape</string>
  <key>ProgramArguments</key>
  <array>
    <string>__NODE__</string>
    <string>--env-file=.env</string>
    <string>dist/scrape.mjs</string>
  </array>
  <key>WorkingDirectory</key><string>__PROJECT__</string>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>__NODE_DIR__:/opt/homebrew/bin:/usr/bin:/bin</string></dict>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>7200</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/rss-music/scrape.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/rss-music/scrape.log</string>
</dict>
</plist>
